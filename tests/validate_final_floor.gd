extends SceneTree
const Helper = preload("res://tests/round_test_helper.gd")

func _initialize() -> void:
	call_deferred("validate")

func validate() -> void:
	var music = root.get_node("MusicManager")
	assert(GameModeConfig.DEMO_FINAL_FLOOR == 6)
	assert(GameModeConfig.DRAPION_FLOOR == GameModeConfig.DEMO_FINAL_FLOOR - 1)
	var data := FinalFloorFactory.create_floor()
	assert(data.tiles.size() == 104)
	assert(TestDungeonFactory.reachable_tiles(data).size() == 104)
	assert(data.rooms == DemoArenaFactory.create_arena().rooms)
	assert(data.player_spawn == FinalFloorFactory.corridor_tile(1))
	for number in range(1, 16):
		var tile := FinalFloorFactory.corridor_tile(number)
		assert(data.get_tile(tile) == DungeonData.TileType.CORRIDOR)
		assert(data.is_walkable(tile + Vector2i.LEFT) == (number < 15))
		assert(data.is_walkable(tile + Vector2i.RIGHT) == (number < 15))
		assert(not data.is_walkable(tile + Vector2i.LEFT * 2))
		assert(not data.is_walkable(tile + Vector2i.RIGHT * 2))
		assert(data.can_traverse(tile, tile + Vector2i.UP))
	assert(not data.is_walkable(data.player_spawn + Vector2i.DOWN))
	var main = load("res://scenes/main/demo_main.tscn").instantiate()
	root.add_child(main)
	Helper.complete_introduction(main)
	var original_environment: Environment = main.get_node("WorldEnvironment").environment
	main.floor_number = GameModeConfig.DRAPION_FLOOR
	main.load_test_floor()
	assert(main.boss != null)
	main.boss.receive_damage(main.boss.health.current)
	assert(main.victory and not main.player.gameplay_enabled)
	main.boss.character_visual.finish_defeat()
	assert(not main.victory and main.player.gameplay_enabled and main.boss == null)
	assert(main.dungeon.stairs_position == DemoArenaFactory.BOSS_CENTER)
	assert(main.dungeon.get_tile(DemoArenaFactory.BOSS_CENTER) == DungeonData.TileType.STAIRS)
	main.player.setup(DemoArenaFactory.BOSS_CENTER + Vector2i.DOWN, main.dungeon, main.dungeon_renderer)
	main.player.try_move(Vector2i.UP)
	assert(main.stairs_prompt != null)
	main.stairs_prompt.choose(true)
	Helper.complete_introduction(main)
	assert(main.floor_number == GameModeConfig.DEMO_FINAL_FLOOR)
	assert(main.player.grid_position == FinalFloorFactory.PLAYER_SPAWN)
	assert(main.enemies.is_empty() and main.boss == null)
	assert(main.final_floor_sequence != null)
	assert(main.final_floor_sequence.backdrop.visible)
	assert(main.get_node("WorldEnvironment").environment == original_environment)
	assert(main.presentation_camera.environment == null)
	assert(main.final_floor_sequence.backdrop.cast_shadow == GeometryInstance3D.SHADOW_CASTING_SETTING_OFF)
	main.update_presentation()
	assert(is_zero_approx(main.presentation_camera.rotation.x))
	assert(is_equal_approx(main.presentation_camera.global_position.z - main.player.global_position.z, 2.0))
	assert(main.player.facing == Vector2i.UP)
	assert(main.final_floor_sequence.walls.visible)
	var environment: FinalCorridorEnvironment = main.final_floor_sequence.walls
	assert(environment.HEIGHT == 2.0)
	assert(environment.filled_cells.size() + main.dungeon.tiles.size() + 9 == environment.bounds.get_area())
	assert(environment.torch_anchors.size() == 14)
	for pair in range(7):
		var left := environment.torch_anchors[pair * 2]
		var right := environment.torch_anchors[pair * 2 + 1]
		assert(is_equal_approx(left.x + right.x, 26.0))
		assert(left.y > 1.1 and left.y < 2.1 and left.y == right.y)
		assert(left.z == right.z and left.z == FinalFloorFactory.corridor_tile(pair * 2 + 1).y)
	var caps: MultiMeshInstance3D = environment.get_node("AuthoredStoneCaps")
	assert(caps.multimesh.mesh == ModularDungeonVisuals.FLOOR)
	assert(caps.material_override.albedo_texture != null)
	for tile in environment.filled_cells:
		assert(environment.bounds.has_point(tile) and not main.dungeon.is_walkable(tile))
	for offset in range(-1, 2):
		assert(FinalFloorFactory.is_music_row(FinalFloorFactory.MUSIC_TILE + Vector2i(offset, 0)))
	assert(not main.final_floor_sequence.center_marker.visible)
	assert(not main.player.acceleration_enabled and not main.player.wait_turn())
	assert(not main.final_approach_music_triggered)
	assert(music.player.stream == null)
	var track := AudioStreamWAV.new()
	track.data = PackedByteArray([0, 0, 0, 0])
	main.final_approach_track = track
	assert(FinalFloorFactory.MUSIC_TILE == FinalFloorFactory.corridor_tile(2))
	main.player.try_move(Vector2i.LEFT)
	Helper.complete(main)
	assert(not main.final_approach_music_triggered)
	main.player.try_move(Vector2i.UP)
	Helper.complete(main)
	assert(main.player.grid_position == FinalFloorFactory.MUSIC_TILE + Vector2i.LEFT)
	assert(main.final_approach_music_triggered)
	assert(music.player.stream == track)
	main.player.try_move(Vector2i.RIGHT)
	Helper.complete(main)
	music.stop_music(main)
	main.player.try_move(Vector2i.DOWN)
	Helper.complete(main)
	main.player.try_move(Vector2i.UP)
	Helper.complete(main)
	assert(music.player.stream == null) # Does not restart on revisits.
	main._on_stairs_reached()
	assert(main.floor_number == GameModeConfig.DEMO_FINAL_FLOOR)
	var move: PokemonMoveData = load("res://config/moves/ember.tres")
	main.player.battle_state.learn_move(move)
	if main.awaiting_move_ack: main.acknowledge_move()
	main.player.battle_state.remaining_pp[0] = 0
	main.player.health.damage(5)
	for number in range(3, 16):
		main.player.try_move(Vector2i.UP)
		Helper.complete(main)
	assert(main.player.grid_position == FinalFloorSequence.RECOVERY_TILE)
	assert(main.player.health.current == main.player.health.maximum)
	assert(main.dialogue.history[-1].message == "HP and PP fully restored.")
	assert(main.player.battle_state.remaining_pp[0] == move.maximum_pp)
	assert(main.final_floor_sequence.recovery_marker.visible)
	assert(main.player.transition_locked)
	main.player.try_move(Vector2i.UP)
	assert(main.player.grid_position == FinalFloorSequence.RECOVERY_TILE)
	main.final_floor_sequence.recovery_effect.animation.pause()
	main.final_floor_sequence.recovery_effect.animation.custom_step(2.19)
	assert(main.player.transition_locked)
	main.final_floor_sequence.recovery_effect.animation.custom_step(0.02)
	assert(not main.player.transition_locked)
	# The recovery tile remains reusable before the entrance seals.
	main.player.try_move(Vector2i.DOWN)
	Helper.complete(main)
	main.player.health.damage(3)
	main.player.battle_state.remaining_pp[0] = 1
	main.player.try_move(Vector2i.UP)
	Helper.complete(main)
	assert(main.player.health.current == main.player.health.maximum)
	assert(main.player.battle_state.remaining_pp[0] == move.maximum_pp)
	main.final_floor_sequence.recovery_effect.animation.pause()
	main.final_floor_sequence.recovery_effect.animation.custom_step(4.0)
	main.player.try_move(Vector2i.UP)
	Helper.complete(main)
	var sequence: FinalFloorSequence = main.final_floor_sequence
	assert(sequence.sealed and main.player.transition_locked)
	assert(sequence.backdrop.visible)
	assert(main.dungeon.tiles.size() == 61)
	assert(TestDungeonFactory.reachable_tiles(main.dungeon).size() == 61)
	assert(not main.dungeon.can_traverse(FinalFloorSequence.ENTRANCE_TILE, FinalFloorSequence.RECOVERY_TILE))
	assert(sequence.walls.visible and not sequence.walls.approach_active and not sequence.recovery_marker.visible)
	assert(sequence.walls.torch_anchors.is_empty())
	assert(sequence.walls.filled_cells.size() + 61 == sequence.walls.bounds.get_area())
	assert(is_equal_approx(main.dungeon_renderer.conventional_wall_height_scale, 0.5))
	for visual in main.dungeon_renderer.fog_visuals:
		assert(visual.mesh.layers != 0 or visual.get("filler", false))
	assert(sequence.center_marker.visible)
	sequence.camera_transition.pause()
	sequence.camera_transition.custom_step(0.35)
	assert(sequence.backdrop.visible)
	sequence.camera_transition.custom_step(0.65)
	assert(sequence.backdrop == null)
	assert(not main.player.transition_locked)
	assert(is_equal_approx(main.presentation_camera.rotation_degrees.x, -35.0))
	assert(is_equal_approx(main.presentation_camera.fov, main.presentation_camera.field_of_view))
	main.player.try_move(Vector2i.DOWN)
	assert(main.player.grid_position == FinalFloorSequence.ENTRANCE_TILE)
	# Restart while a second entrance transition is active; stale Tween must stop.
	main.load_test_floor()
	main.player.setup(FinalFloorSequence.RECOVERY_TILE, main.dungeon, main.dungeon_renderer)
	main.player.try_move(Vector2i.UP)
	var stale_tween: Tween = main.final_floor_sequence.camera_transition
	main.start_new_run()
	assert(not stale_tween.is_running())
	assert(main.player.transition_locked)
	Helper.complete_introduction(main)
	assert(main.floor_number == 1 and main.player.acceleration_enabled)
	assert(main.final_floor_sequence == null)
	assert(is_equal_approx(main.presentation_camera.rotation_degrees.x, -35.0))
	assert(not main.final_approach_music_triggered)
	assert(music.player.stream == music.dungeon_track)
	main.free()
	await process_frame
	print("PASS: final floor 15-row three-wide corridor/61-cell diamond, textured full-height fill, paired upper torches, Drapion stairs, row-2 music once, J restriction, corridor camera, reusable recovery, sealed diamond/light, camera blend and restart cancellation")
	quit()
